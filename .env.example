# ATS Plugin — Environment Variables
# Copy to .env and fill in your values.
#
# Network is opt-in: set HEDERA_NETWORK and you get that network, at your own risk.
# testnet (default) uses test HBAR; mainnet moves real value and is irreversible.

# Hedera operator (ECDSA)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.XXXXXXX
HEDERA_OPERATOR_KEY=<64-char-hex-raw-ecdsa-private-key>
HEDERA_OPERATOR_KEY_TYPE=ECDSA
HEDERA_OPERATOR_PUBLIC_KEY=<compressed-public-key-hex>
HEDERA_OPERATOR_EVM_ADDRESS=<evm-address-hex>

# ATS Factory + Resolver (public testnet reference deployment)
ATS_FACTORY_ADDRESS=0.0.7512002
ATS_RESOLVER_ADDRESS=0.0.7511642

# Hedera endpoints
# Defaults follow HEDERA_NETWORK when omitted. For mainnet use e.g.:
#   HEDERA_MIRROR_NODE_URL=https://mainnet-public.mirrornode.hedera.com
#   HEDERA_RPC_URL=https://mainnet.hashio.io/api
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_RPC_URL=https://testnet.hashio.io/api

# HCS securities registry (optional)
# Leave blank to create a new topic on first use; set to reuse a registry across runs.
HCS_REGISTRY_TOPIC_ID=

# LLM provider
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Safety policies
MAX_SUPPLY_CAP=1000000
JURISDICTION_ALLOWLIST=US,GB,DE,FR,MA,AE,SG,JP

# Investor test account (optional, for demo)
INVESTOR_ACCOUNT_ID=0.0.XXXXXXX
INVESTOR_PRIVATE_KEY=<64-char-hex-raw-ecdsa-private-key>
INVESTOR_PUBLIC_KEY=<compressed-public-key-hex>
INVESTOR_EVM_ADDRESS=<evm-address-hex>
